.env
__pycache__/
*.pyc
.venv/
.venv311/
venv/
.pytest_cache/

# Traces are the evidence artifact and are committed deliberately, so there is
# no blanket traces/* rule here. The delivery side ignored traces/*.jsonl and
# traces/*.json wholesale; adopting that would hide the preflight, bench and
# round-trip files RIME_EVIDENCE.md cites. Ignore only the per-run noise.
traces/*.wav
traces/numbers/
traces/session_*.jsonl
traces/chat_demo.jsonl
traces/demo_ledger.jsonl
notes/*.jsonl

# dev-only runtime uploads: never committed, never in index.json

examples/policy-reader/web/node_modules/
examples/policy-reader/web/dist/
examples/policy-reader/web/*.tsbuildinfo

# Source documents for the structure pass are provided locally by the developer.
# Commit the extracted .docling.json and the fixture, never the source file, unless licensing is confirmed.
examples/policy-reader/fixtures/source/*.pdf
examples/policy-reader/fixtures/source/*.docx
_stage/
examples/policy-reader/fixtures/.incoming_*
