# Copy to .env (server-side only). Never commit .env. Never put the key in client code, docs, or recordings.
RIME_API_KEY=your_rime_api_key_here

# Shipped Rime path — every value here must match README "Rime integration" and RIME_EVIDENCE.md exactly.
RIME_WS_URL=wss://users-ws.rime.ai/ws3          # us-west; us-east: wss://users-east-ws.rime.ai/ws3
RIME_MODEL_ID=coda                               # explicit. Omitting it silently serves Mist v3.
RIME_SPEAKER=                                    # pick from `python scripts/fetch_voices.py --list`; verified live at submission
RIME_LANG=en                                     # en/es only emit word timestamps
RIME_AUDIO_FORMAT=pcm                            # raw s16le mono
RIME_SAMPLING_RATE=24000
RIME_SEGMENT=bySentence                          # never | bySentence | immediate
RIME_SPEED_ALPHA=1.0                             # only speed control honoured over WebSocket
RIME_TIMESTAMP_CLOCK=per_context                 # or cumulative — set from scripts/preflight_rime.py output

# Optional
RIME_CATALOG_URL=https://users.rime.ai/data/voices/all-v2.json
RIME_TEXTNORM_URL=                               # only used by scripts/number_roundtrip.py --textnorm (comparison, not shipped path)

# Fallback (disclosed). rime | fake. The active provider is always logged as `provider_active`.
TTS_PROVIDER=rime

# Not owned by this slice (Person B): STT / LLM / LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LLM_API_KEY=                                     # not needed for LLM_PROVIDER=ollama
LLM_PROVIDER=ollama                              # anthropic | openai | ollama. Unset with no key == extractive answers
LLM_MODEL=granite4.2:3b                          # shipped local model: `ollama pull granite4.2:3b` (2.2 GB, fits a 6 GB GPU)
LLM_BASE_URL=                                    # ollama default http://localhost:11434/v1; from WSL2 use the Windows host IP if localhost fails
LLM_TIMEOUT_S=30                                 # answer is on the voice line; past this the extractive answer is spoken
LLM_MAX_TOKENS=256                               # a spoken reply, not an essay

# Build-time enrichment (scripts/enrich.py). Never used by the judged runtime path.
ENRICH_PROVIDER=none          # ollama | groq | none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite4.2:3b        # same pull as LLM_MODEL; one local model for enrichment and answers
GROQ_API_KEY=                 # console.groq.com/keys — server-side only
GROQ_MODEL=                   # pick from GET /openai/v1/models
